# Track the active source tree and build recipes, not the local game installation.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/AGENTS.md
!/build.py
!/CLAUDE_PERFORMANCE_LEVELS.md
!/HANDOFF_PERFORMANCE_STATUES_2026-11-22.md
!/Source/
!/graphics/
!/keysource/
!/Build/
/Build/*
!/Build/Catherine.rsp
!/Build/perf/
/Build/perf/*
!/Build/perf/pgo/
/Build/perf/pgo/*
!/Build/perf/pgo/pgo_build.py
!/Build/perf/pgo/pgo_hook.cpp

# Editor/compiler and Python caches.
**/.cache/
**/__pycache__/
**/obj/
**/bin/
**/.vs/
**/.idea/
**/node_modules/
*.pyc
*.obj
*.pdb
*.ilk
*.log
*.profraw
*.profdata

# Original game data and machine-specific files never belong in source control.
assets.pak
*.image
romfs.bin
save.dat
catherine-settings.ini
assets-sources.json
assets-verification.json
assets-progress.json
assets-missing.txt
.env
.env.*
*.pem
*.key
*.pfx
*.p12
