#version 450
// Dense current-to-previous flow from real consecutive game frames. Camera
// reprojection seeds a multiscale block match; object motion is refined from RGB.
layout(local_size_x=8,local_size_y=8) in;
layout(binding=0) uniform sampler2D currentColor;
layout(binding=1) uniform sampler2D previousColor;
layout(binding=2) uniform sampler2D sceneDepth;
layout(binding=3,rg16f) writeonly uniform image2D motion;
layout(binding=4,r32f) writeonly uniform image2D depthCopy;
layout(binding=5,rgba8) writeonly uniform image2D history;
layout(push_constant) uniform Params {mat4 clipToPrevious;vec4 dimensions;} pc;
float cost(vec2 uv,vec2 delta){
 float error=0;vec2 texel=1.0/pc.dimensions.xy;
 for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x){
  vec2 offset=vec2(x,y)*texel*2;
  vec3 a=textureLod(currentColor,uv+offset,0).rgb;
  vec3 b=textureLod(previousColor,uv+offset+delta,0).rgb;
  error+=dot(abs(a-b),vec3(.299,.587,.114));
 }
 return error;
}
void main(){
 ivec2 pixel=ivec2(gl_GlobalInvocationID.xy),size=imageSize(motion);
 if(any(greaterThanEqual(pixel,size)))return;
 vec2 uv=(vec2(pixel)+.5)/vec2(size);float depth=textureLod(sceneDepth,uv,0).r;
 vec3 color=textureLod(currentColor,uv,0).rgb;vec2 best=vec2(0);
 if(pc.dimensions.z>0){
  vec4 previous=pc.clipToPrevious*vec4(uv.x*2-1,1-uv.y*2,depth*2-1,1);
  vec2 previousUV=vec2(previous.x,-previous.y)/previous.w*.5+.5;
  vec2 seed=previousUV-uv;
  if(any(isnan(seed))||any(isinf(seed)))seed=vec2(0);
  best=clamp(seed,vec2(-.25),vec2(.25));float lowest=cost(uv,best);
  // Always also consider static pixels (HUD and independently moving objects).
  float zero=cost(uv,vec2(0));if(zero<lowest){lowest=zero;best=vec2(0);}
  for(int step=16;step>=1;step/=2){
   vec2 origin=best;
   for(int y=-1;y<=1;++y)for(int x=-1;x<=1;++x){
    vec2 candidate=origin+vec2(x,y)*float(step)/vec2(size);
    float error=cost(uv,candidate)+.0005*length(candidate-seed)*float(size.x);
    if(error<lowest){lowest=error;best=candidate;}
   }
  }
 }
 imageStore(motion,pixel,vec4(best,0,0));
 imageStore(depthCopy,pixel,vec4(depth));imageStore(history,pixel,vec4(color,1));
}
